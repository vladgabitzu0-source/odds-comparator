# Backend environment variables.
#
# Copy this file to ".env" and fill in real values, OR export these as real
# environment variables in your shell / hosting provider. The .env file is
# gitignored so credentials never reach the repository.
#
# This public build's live scraper (Superbet) doesn't require a proxy — these
# variables are unused here. Left as a placeholder since a proxy-routing config
# is part of the production system for a different source; see the README's
# "Key Technical Challenges" section.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
