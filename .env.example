# Backend environment variables.
#
# Copy this file to ".env" and fill in real values, OR export these as real
# environment variables in your shell / hosting provider. The .env file is
# gitignored so credentials never reach the repository.
#
# All of these are OPTIONAL. They are only needed when scraping Betano through a
# residential proxy (required from datacenter IPs, where Cloudflare blocks the
# scrape). For local development you can leave them unset: when PROXY_SERVER is
# empty the scraper connects directly with no proxy.

# Upstream residential proxy, "host:port" (scheme optional, e.g. http://host:port).
PROXY_SERVER=

# Proxy authentication (e.g. an IPRoyal residential endpoint username/password).
PROXY_USERNAME=
PROXY_PASSWORD=
